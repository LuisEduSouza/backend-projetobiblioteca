{
    "openapi": "3.0.0",
    "info": {
        "version": "v1.0.0",
        "title": "Biblioteca",
        "description": "Implementação do Swigger à API"
    },
    "servers": [
        {
            "url": "http://localhost:3333",
            "description": ""
        }
    ],
    "paths": {
        "/lista/alunos": {
            "get": {
                "tags": [
                    "Aluno"
                ],
                "summary": "Listar todos os alunos",
                "description": "Retorna uma lista com todos os alunos cadastrados.",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Lista de alunos retornada com sucesso"
                    },
                    "400": {
                        "description": "Erro ao recuperar os alunos"
                    }
                }
            }
        },
        "/novo/aluno": {
            "post": {
                "tags": [
                    "Aluno"
                ],
                "summary": "Cadastrar novo aluno",
                "description": "Recebe dados de um aluno para cadastro.",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Aluno"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Aluno cadastrado com sucesso"
                    },
                    "400": {
                        "description": "Erro ao cadastrar aluno"
                    }
                }
            }
        },
        "/delete/aluno/{idAluno}": {
            "put": {
                "tags": [
                    "Aluno"
                ],
                "summary": "Inativar aluno",
                "description": "Atualiza o status do aluno para 'indisponível' (soft delete).",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "idAluno",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Aluno inativado com sucesso"
                    },
                    "400": {
                        "description": "Erro ao inativar aluno"
                    }
                }
            }
        },
        "/atualizar/aluno/{idAluno}": {
            "put": {
                "tags": [
                    "Aluno"
                ],
                "summary": "Atualizar aluno",
                "description": "Atualiza as informações de um aluno pelo ID.",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "idAluno",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Aluno"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Aluno atualizado com sucesso"
                    },
                    "400": {
                        "description": "Erro ao atualizar aluno"
                    }
                }
            }
        },
        "/lista/livros": {
            "get": {
                "tags": [
                    "Livro"
                ],
                "summary": "Listar todos os livros",
                "description": "Retorna uma lista de todos os livros cadastrados.",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Lista de livros retornada com sucesso"
                    },
                    "400": {
                        "description": "Erro ao recuperar os livros"
                    }
                }
            }
        },
        "/novo/livro": {
            "post": {
                "tags": [
                    "Livro"
                ],
                "summary": "Cadastrar novo livro",
                "description": "Cadastro de um novo livro com upload de capa (multipart/form-data).",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "titulo": {
                                        "type": "string",
                                        "example": "Senhor dos Anéis"
                                    },
                                    "autor": {
                                        "type": "string",
                                        "example": "J.R.R. Tolkien"
                                    },
                                    "editora": {
                                        "type": "string",
                                        "example": "Martins Fontes"
                                    },
                                    "anoPublicacao": {
                                        "type": "integer",
                                        "example": 1954
                                    },
                                    "capa": {
                                        "type": "string",
                                        "format": "binary"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Livro cadastrado com sucesso"
                    },
                    "400": {
                        "description": "Erro ao cadastrar livro"
                    }
                }
            }
        },
        "/delete/livro/{idLivro}": {
            "put": {
                "tags": [
                    "Livro"
                ],
                "summary": "Inativar livro",
                "description": "Atualiza o status de um livro para 'indisponível'.",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "idLivro",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Livro inativado com sucesso"
                    },
                    "400": {
                        "description": "Erro ao inativar livro"
                    }
                }
            }
        },
        "/atualizar/livro/{idLivro}": {
            "put": {
                "tags": [
                    "Livro"
                ],
                "summary": "Atualizar livro",
                "description": "Atualiza os dados de um livro pelo ID.",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "idLivro",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Livro"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Livro atualizado com sucesso"
                    },
                    "400": {
                        "description": "Erro ao atualizar livro"
                    }
                }
            }
        },
        "/lista/emprestimos": {
            "get": {
                "tags": [
                    "Emprestimo"
                ],
                "summary": "Listar todos os empréstimos",
                "description": "Retorna todos os empréstimos cadastrados.",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Lista de empréstimos retornada com sucesso"
                    },
                    "400": {
                        "description": "Erro ao recuperar empréstimos"
                    }
                }
            }
        },
        "/novo/emprestimo": {
            "post": {
                "tags": [
                    "Emprestimo"
                ],
                "summary": "Cadastrar novo empréstimo",
                "description": "Cadastra um novo empréstimo de livro.",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "idLivro": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "idAluno": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "dataEmprestimo": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2025-06-18"
                                    },
                                    "dataDevolucao": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2025-06-25"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Empréstimo cadastrado com sucesso"
                    },
                    "400": {
                        "description": "Erro ao cadastrar empréstimo"
                    }
                }
            }
        },
        "/atualizar/emprestimo/{idEmprestimo}": {
            "put": {
                "tags": [
                    "Emprestimo"
                ],
                "summary": "Atualizar empréstimo",
                "description": "Atualiza os dados de um empréstimo.",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "idEmprestimo",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "dataDevolucao": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2025-06-30"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Empréstimo atualizado com sucesso"
                    },
                    "400": {
                        "description": "Erro ao atualizar empréstimo"
                    }
                }
            }
        },
        "/delete/emprestimos/{idEmprestimo}": {
            "put": {
                "tags": [
                    "Emprestimo"
                ],
                "summary": "Inativar empréstimo",
                "description": "Atualiza o status de um empréstimo para inativo.",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "idEmprestimo",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Empréstimo inativado com sucesso"
                    },
                    "400": {
                        "description": "Erro ao inativar empréstimo"
                    }
                }
            }
        },
        "/lista/usuarios": {
            "get": {
                "tags": [
                    "Usuario"
                ],
                "summary": "Listar usuários",
                "description": "Lista todos os usuários cadastrados no sistema.",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Lista de usuários retornada com sucesso"
                    },
                    "400": {
                        "description": "Erro ao recuperar usuários"
                    }
                }
            }
        },
        "/novo/usuario": {
            "post": {
                "tags": [
                    "Usuario"
                ],
                "summary": "Cadastrar novo usuário",
                "description": "Cadastra um novo usuário com upload de imagem de perfil.",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "nome": {
                                        "type": "string",
                                        "example": "Carlos"
                                    },
                                    "email": {
                                        "type": "string",
                                        "example": "carlos@example.com"
                                    },
                                    "senha": {
                                        "type": "string",
                                        "example": "senha123"
                                    },
                                    "imagemPerfil": {
                                        "type": "string",
                                        "format": "binary"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Usuário cadastrado com sucesso"
                    },
                    "400": {
                        "description": "Erro ao cadastrar usuário"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Aluno": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "nome": {
                        "type": "string",
                        "example": "James"
                    },
                    "sobrenome": {
                        "type": "string",
                        "example": "Rafael"
                    },
                    "dataNascimento": {
                        "type": "string",
                        "format": "date",
                        "example": "2008-04-03"
                    },
                    "endereco": {
                        "type": "string",
                        "example": "Rua Futebol, 008"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "trem@futebol.com"
                    },
                    "celular": {
                        "type": "string",
                        "example": "16988620628"
                    }
                },
                "required": [
                    "nome",
                    "sobrenome",
                    "dataNascimento",
                    "endereco",
                    "email",
                    "celular"
                ]
            },
            "Livro": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "titulo": {
                        "type": "string",
                        "example": "Senhor dos Anéis"
                    },
                    "autor": {
                        "type": "string",
                        "example": "J.R.R. Tolkien"
                    },
                    "editora": {
                        "type": "string",
                        "example": "Martins Fontes"
                    },
                    "anoPublicacao": {
                        "type": "integer",
                        "example": 1954
                    },
                    "caminhoCapa": {
                        "type": "string",
                        "example": "/uploads/capas/1.jpg"
                    }
                },
                "required": [
                    "titulo",
                    "autor",
                    "editora",
                    "anoPublicacao"
                ]
            },
            "Emprestimo": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "idAluno": {
                        "type": "integer",
                        "example": 1
                    },
                    "idLivro": {
                        "type": "integer",
                        "example": 1
                    },
                    "dataEmprestimo": {
                        "type": "string",
                        "format": "date",
                        "example": "2025-06-18"
                    },
                    "dataDevolucao": {
                        "type": "string",
                        "format": "date",
                        "example": "2025-06-25"
                    },
                    "status": {
                        "type": "string",
                        "example": "ativo"
                    }
                },
                "required": [
                    "idAluno",
                    "idLivro",
                    "dataEmprestimo",
                    "dataDevolucao"
                ]
            },
            "Usuario": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "nome": {
                        "type": "string",
                        "example": "Carlos"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "carlos@example.com"
                    },
                    "senha": {
                        "type": "string",
                        "example": "senha123"
                    },
                    "caminhoImagemPerfil": {
                        "type": "string",
                        "example": "/uploads/usuarios/1.jpg"
                    }
                },
                "required": [
                    "nome",
                    "email",
                    "senha"
                ]
            }
        },
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer"
            }
        }
    }
}